@Service
public class PregledServiceImpl implements PregledService{
    
    private final PregledRepository pregledRepository;
    private final LekarRepository lekarRepository;
    private final PacijentRepository pacijentRepository;
    private final PregledConverter pregledConverter;
    private final EntityManagerFactory emf;

    @Autowired
    public PregledServiceImpl(PregledRepository pregledRepository, LekarRepository lekarRepository, PacijentRepository pacijentRepository, PregledConverter pregledConverter, EntityManagerFactory emf) {
        this.pregledRepository = pregledRepository;
        this.lekarRepository = lekarRepository;
        this.pacijentRepository = pacijentRepository;
        this.pregledConverter = pregledConverter;
        this.emf = emf;
    }
    
    

    @Override
    public void save(PregledDto p) {
        
        EntityManager em=emf.createEntityManager();
        em.getTransaction().begin();

        Pregled pregled=pregledConverter.toEntity(p);
        pregled.setLekar(lekarRepository.findById(p.getLekar()));
        pregled.setPacijent(pacijentRepository.findById(p.getPacijent()));
        
        pregledRepository.save(em, pregled);
        em.getTransaction().commit();
        
        
    }
    
}
