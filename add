public class DodajAction implements Action{
    @Autowired
    private PregledService pregledService;

    @Override
    public String execute(HttpServletRequest request) {

        String opis=request.getParameter("opis");
        String cena=request.getParameter("cena");
        LekarDto l=(LekarDto) request.getSession(false).getAttribute("k");
        String pId=request.getParameter("pac");
        
        PregledDto pregled=new PregledDto(Long.MIN_VALUE, LocalDate.now(), opis, Long.parseLong(cena), 
                l.getId(), Long.parseLong(pId));
        pregledService.save(pregled);
        return "WEB-INF/main.jsp";
    }
    
}
