@WebServlet(name = "PregledServlet", urlPatterns = {"/pregled"})
public class PregledServlet extends HttpServlet {
    
    
    @Autowired
    @Qualifier("dodaj")
    private Action dodajAction;

    @Override
    public void init(ServletConfig config) throws ServletException {
        super.init(config);
    
        ApplicationContext context=(ApplicationContext) config.getServletContext().getAttribute("c");
        context.getAutowireCapableBeanFactory().autowireBean(this);
        
    }
    
    
    protected void processRequest(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {
        response.setContentType("text/html;charset=UTF-8");
        
        String page="WEB-INF/main.jsp";
        String action =request.getParameter("action");
        
        if(action.equals("dodaj")){
            page="WEB-INF/dodaj.jsp";
        }
        if(action.equals("sacuvaj")){
            page=dodajAction.execute(request);
        }
        
        request.getRequestDispatcher(page).forward(request, response);
    }
}
