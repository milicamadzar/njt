@Repository
public class LekarJpaRepository implements LekarRepository{
    
    @Autowired
    private final EntityManagerFactory emf;

    public LekarJpaRepository(EntityManagerFactory emf) {
        this.emf = emf;
    }
    @Override
    public Lekar login(String kIme, String sifra) {

        EntityManager em=emf.createEntityManager();
        
        try{
            return em.createQuery("SELECT l FROM Lekar l WHERE l.kIme=:kIme AND l.sifra=:sifra", Lekar.class)
                    .setParameter("kIme", kIme).setParameter("sifra", sifra).getSingleResult();
        }catch(NoResultException e){
            return null;
        }
        finally{
            em.close();
        }
    }

    @Override
    public Lekar findById(Long id) {

        EntityManager em=emf.createEntityManager();
        return em.find(Lekar.class, id);
    }
    
}
