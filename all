public class LoginAction implements Action{
    
    @Autowired
    private LekarService lekarService;
    @Autowired
    private PacijentService pacijentService;

    @Override
    public String execute(HttpServletRequest request) {

        String kIme=request.getParameter("kIme");
        String sifra=request.getParameter("sifra");
        
        LekarDto l=lekarService.login(kIme, sifra);
        if(l==null){
            request.setAttribute("greska", "ne postoji");
            return "/login.jsp";
        }
        HttpSession session=request.getSession(true);
        session.setAttribute("k", l);
        
        List<LekarDto> ulogovani=(List<LekarDto>) request.getServletContext().getAttribute("u");
        if(ulogovani==null){
            ulogovani=new ArrayList<>();
            request.getServletContext().setAttribute("u", ulogovani);
        }
        
        for (LekarDto lekar : ulogovani) {
            if(lekar.getId()==l.getId()){
                request.setAttribute("greska", "vec ulogovan");
                return "/login.jsp";
            }
        }
        List<PacijentDto> pacijenti=pacijentService.vrati();
        request.getServletContext().setAttribute("p", pacijenti);
        
        ulogovani.add(l);
        return "WEB-INF/main.jsp";
    }
   
}


